<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <artifactId>smart-s7-connector</artifactId>
    <groupId>io.github.maidamai</groupId>
    <packaging>jar</packaging>
    <!-- 1.0.0-SNAPSHOT: development line after the v1.0.0-rc.2 pre-release
         (GitHub Releases, 2026-09-17). Central publication of rc.2 or a
         final 1.0.0 is pending maintainer credentials; see
         docs/releasing.md. -->
    <version>1.0.0-SNAPSHOT</version>
    <name>smart-s7-connector</name>
    <description>Lightweight Siemens S7 PLC communication library for Java.</description>
    <url>https://github.com/Maidamai/smart-s7-connector</url>

    <licenses>
        <!-- Split per-file licensing, decided 2026-09-17 (docs/provenance.md §5).
             The two entries describe scopes, not an either/or choice: a
             consumer may not use the whole artifact under Apache-2.0 alone. -->
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
            <comments>Applies to every source file of this artifact except io/github/maidamai/s7connector/impl/nodave/**, i.e. the original smart-s7-connector code plus the Apache-2.0-licensed parts inherited from s7connector.</comments>
        </license>
        <license>
            <name>GNU Library General Public License v2.0 or later</name>
            <url>https://www.gnu.org/licenses/old-licenses/lgpl-2.0.txt</url>
            <distribution>repo</distribution>
            <comments>Applies to io/github/maidamai/s7connector/impl/nodave/** (7 files derived from libnodave, Copyright Thomas Hergenhahn 2005, via the s7connector Java port). Their "or any later version" grant allows a combined distribution to elect LGPL-3.0-or-later, which is one-way compatible with the Apache-2.0 parts. See LICENSES/LGPL-2.0.txt and THIRD_PARTY_NOTICES.md.</comments>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>Maidamai</id>
            <name>Caijiangtao</name>
            <url>https://github.com/Maidamai</url>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/Maidamai/smart-s7-connector</url>
        <connection>scm:git:https://github.com/Maidamai/smart-s7-connector.git</connection>
        <developerConnection>scm:git:git@github.com:Maidamai/smart-s7-connector.git</developerConnection>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/Maidamai/smart-s7-connector/issues</url>
    </issueManagement>

    <properties>
        <!-- Java 8 compatibility: on JDK 9+ the jdk9plus profile sets
             maven.compiler.release=8 (API-checked cross-compilation);
             on a JDK 8 toolchain the release flag does not exist, so the
             default source/target pair compiles natively. -->
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.jupiter.version>5.14.2</junit.jupiter.version>
        <maven.surefire.version>3.5.4</maven.surefire.version>
        <maven.failsafe.version>3.5.4</maven.failsafe.version>
        <maven.compiler.plugin.version>3.15.0</maven.compiler.plugin.version>
        <!-- Live PLC integration tests are opt-in; empty defaults keep the
             failsafe property mapping inert unless overridden with -D on the
             command line. See docs/testing.md. -->
        <plc.host></plc.host>
        <plc.port></plc.port>
        <plc.rack></plc.rack>
        <plc.slot></plc.slot>
        <plc.timeoutMillis></plc.timeoutMillis>
        <plc.allowWrites></plc.allowWrites>
        <plc.allow.ranges></plc.allow.ranges>
        <plc.tags.file></plc.tags.file>
        <plc.scale.cycles></plc.scale.cycles>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.17</version>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
            <version>4.1.121.Final</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.17</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Ship the applicable license texts and notices inside the
             artifacts (T09): Apache-2.0 for the project code, LGPL-2.0 for
             the libnodave-derived nodave files. These land in the main JAR
             via target/classes and maven-source-plugin 3.3.1 carries the
             same resources into the sources JAR (verified 2026-09-17). -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>LICENSE</include>
                    <include>NOTICE</include>
                    <include>LICENSE_LIBNODAVE.txt</include>
                    <include>THIRD_PARTY_NOTICES.md</include>
                </includes>
            </resource>
            <resource>
                <directory>${project.basedir}/LICENSES</directory>
                <targetPath>META-INF/licenses</targetPath>
                <includes>
                    <include>LGPL-2.0.txt</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:-options</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.version}</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- API-checked Java 8 cross-compilation whenever the build runs on
             JDK 9 or newer (the local default and all CI legs except the
             JDK 8 one, which compiles natively via source/target). -->
        <profile>
            <id>jdk9plus-release</id>
            <activation>
                <jdk>[9,)</jdk>
            </activation>
            <properties>
                <maven.compiler.release>8</maven.compiler.release>
            </properties>
        </profile>
        <!-- Release artifact generation. Never activated implicitly; the
             actual upload is a manual, maintainer-only step described in
             docs/releasing.md and requires credentials that must never
             enter this repository. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <doclint>none</doclint>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Opt-in runner for the *IT live-PLC tests. Plain `mvn test` never
             selects them, and live writes additionally require
             -Dplc.allowWrites=true -Dplc.allow.ranges=... enforced by
             LivePlcTestGuard before any connection is opened. -->
        <profile>
            <id>plc-live-it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>${maven.failsafe.version}</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <plc.host>${plc.host}</plc.host>
                                <plc.port>${plc.port}</plc.port>
                                <plc.rack>${plc.rack}</plc.rack>
                                <plc.slot>${plc.slot}</plc.slot>
                                <plc.timeoutMillis>${plc.timeoutMillis}</plc.timeoutMillis>
                                <plc.allowWrites>${plc.allowWrites}</plc.allowWrites>
                                <plc.allow.ranges>${plc.allow.ranges}</plc.allow.ranges>
                                <plc.tags.file>${plc.tags.file}</plc.tags.file>
                                <plc.scale.cycles>${plc.scale.cycles}</plc.scale.cycles>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
